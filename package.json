{
    "name": "gitmap",
    "version": "2.7.3",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "compile": "sass src/styles.scss src/styles.css",
        "deploy": "gh-pages -d dist",
        "test-name": "node tests/tools/generateTestName.js",
        "ES-check": "npx eslint src/",
        "ES-fix": "npx eslint src/ --fix",
        "Style-check": "stylelint \"**/*.scss\"",
        "Style-fix": "stylelint \"**/*.scss\" --fix",
        "prettier": "prettier src/ --write",
        "check-all": "npm-run-all --continue-on-error ES-check Style-check",
        "fix-all": "npm-run-all --continue-on-error ES-fix Style-fix prettier"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "gh-pages": "^6.3.0",
        "globals": "^17.11.0",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vite": "^8.2.0"
    }
}
