{
    "name": "gitmap",
    "version": "1.5.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "compile": "sass src/styles.scss src/styles.css",
        "deploy": "gh-pages -d dist",
        "test-name": "node tests/tools/generateTestName.js",
        "ESLint-check": "npx eslint src/",
        "ESLint-fix": "npx eslint src/ --fix",
        "StyleLint-check": "stylelint \"**/*.scss\"",
        "StyleLint-fix": "stylelint \"**/*.scss\" --fix",
        "format": "prettier src/ --write",
        "global-check": "npm run ESLint-check && npm run StyleLint-check",
        "global-fix": "npm run ESLint-fix && npm run StyleLint-fix"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "gh-pages": "^6.3.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "stylelint": "^17.14.1",
        "vite": "^8.2.0"
    }
}
